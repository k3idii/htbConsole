$secondary: #9fef00;
$secondary-lighten-1: #ddff99;
$background: #111927;
$background-darken-1: #171717;
$background-lighten-1: #1a2332;
$border: #3d5276;
$border-title-color: #a4b1cd;
$color: #a4b1cd;

Header {
    color: $secondary;
    background: $background-darken-1;
    text-style: bold;
}

#container-main {
    height: 1fr;
}


/* ── CTF List View ── */

#ctf_list_view {
    width: 1fr;
    height: 1fr;
    background: $background;
    color: $color;

    #ctf_player_info {
        width: 100%;
        height: auto;
        padding: 1;
        background: $background-lighten-1;
        border: panel $border;
        border-title-color: $secondary;
        margin-bottom: 1;
    }

    #ctf_list_tabs {
        width: 1fr;
        height: 1fr;
    }

    CTFTable {
        width: 1fr;
        height: 1fr;

        & > .datatable--header {
            background: $background-lighten-1;
        }

        & > .datatable--header-hover {
            background: $background-lighten-1;
            color: #fff;
        }
    }
}


/* ── CTF Context View ── */

#ctf_challenges_view {
    width: 1fr;
    height: 1fr;
    background: $background;
    color: $color;

    #ctf_context_tabs {
        width: 1fr;
        height: 1fr;
    }

    /* General tab */
    #ctf_general_info {
        width: 100%;
        height: auto;
        padding: 1;
    }

    /* Tasks tab */
    #ctf_chall_layout {
        width: 1fr;
        height: 1fr;
        layout: horizontal;

        #ctf_cat_pane {
            width: 20%;
            height: 1fr;

            #ctf_cat_table {
                width: 100%;
                height: 1fr;

                & > .datatable--header {
                    background: $background-lighten-1;
                }
            }

            #ctf_create_dirs_btn {
                width: 100%;
                height: 3;
                dock: bottom;
                background: $border;
                color: $color;
            }
        }

        #ctf_chall_pane {
            width: 25%;
            height: 1fr;

            #ctf_chall_table {
                width: 100%;
                height: 1fr;

                & > .datatable--header {
                    background: $background-lighten-1;
                }

                & > .datatable--header-hover {
                    background: $background-lighten-1;
                    color: #fff;
                }
            }
        }

        #ctf_detail_pane {
            width: 55%;
            height: 1fr;
            background: $background-lighten-1;
            border: panel $border;
            border-title-color: $border-title-color;

            #ctf_detail_tabs {
                width: 1fr;
                height: 1fr;
            }

            #ctf_detail_scroll {
                width: 100%;
                height: 1fr;
            }

            #ctf_chall_detail {
                width: 100%;
                height: auto;
            }

            #ctf_action_buttons {
                height: 3;
                width: 100%;

                #ctf_download_btn {
                    width: 1fr;
                    background: $secondary;
                    border-top: tall $secondary-lighten-1;
                    border-bottom: tall $secondary 30%;
                }

                #ctf_download_btn:disabled {
                    background: $border;
                    border-top: tall $border;
                    border-bottom: tall $border;
                    color: $color 50%;
                }
            }

            #ctf_flag_container {
                height: 3;
                width: 100%;

                #ctf_flag_input {
                    width: 70%;
                }

                #ctf_flag_submit {
                    width: 30%;
                    background: $secondary;
                    color: black;
                    border-top: tall $secondary-lighten-1;
                    border-bottom: tall $secondary 30%;
                }
            }

            /* Notes tab */
            #ctf_notes_label {
                width: 100%;
                height: 1;
                color: $color 70%;
                padding: 0 1;
            }

            #ctf_notes_editor {
                width: 100%;
                height: 1fr;
            }
        }
    }

    /* Ranking tab */
    #ctf_ranking_team_info {
        width: 100%;
        height: auto;
        padding: 1;
        background: $background-lighten-1;
        border: panel $border;
        border-title-color: $secondary;
        margin-bottom: 1;
    }

    #ctf_ranking_table,
    #ctf_scoreboard_table {
        width: 100%;
        height: 1fr;

        & > .datatable--header {
            background: $background-lighten-1;
        }

        & > .datatable--header-hover {
            background: $background-lighten-1;
            color: #fff;
        }
    }

    #ctf_scoreboard_info {
        width: 100%;
        height: auto;
        padding: 1;
        background: $background-lighten-1;
        border: panel $border;
        border-title-color: $secondary;
        margin-bottom: 1;
    }
}


/* ── Scrollbar theming ── */

DataTable {
    scrollbar-background: #111;
    scrollbar-background-active: transparent;
    scrollbar-background-hover: transparent;
    scrollbar-color: $secondary 50%;
    scrollbar-color-active: $secondary;
    scrollbar-color-hover: $secondary 70%;
    scrollbar-size: 0 1;
}
